# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://astor:astor@localhost:5432/astor

# Embeddings: pluggable. dev = offline deterministic (no API, for local runs/tests).
# Swap to a real provider (voyage / openai) before trusting match quality.
EMBEDDINGS_PROVIDER=dev
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# LLM extraction (used for PDF/HTML catalogs; CSV/XLSX need no LLM)
ANTHROPIC_API_KEY=

# Shopify house-catalog feed (Dev Dashboard app, post-2026 auth).
# SHOP_DOMAIN is the *.myshopify.com handle, NOT the public .us domain.
# Provide EITHER a legacy static token OR the Dev Dashboard client pair.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=          # only if you have a legacy admin-created app
SHOPIFY_API_VERSION=2026-01
# SHOPIFY_MPN_METAFIELD=custom.mpn
# SHOPIFY_SPECS_METAFIELD_NAMESPACE=specs

# protocols.io developer API (protocols.io/developers -> client access token).
# The API rejects anything else with status_code 1218: it requires
#   Authorization: Bearer <access_token>
# Scope note: a token enables single documented fetches. It does NOT clear the
# ToS restriction on systematic download / database population -- see
# contracts/astor-protocol-ingest.v1.yaml (PI-6) before any sweep.
PROTOCOLS_IO_TOKEN=

# Matching thresholds
EQUIV_EXACT_THRESHOLD=0.92
EQUIV_SUBSTITUTE_THRESHOLD=0.80
EQUIV_CANDIDATES=20

LOG_LEVEL=INFO

# Gates the internal /api/* surface. Unset locally = open; REQUIRED in production.
# ADMIN_TOKEN=
# Public hosts set this true so a missing ADMIN_TOKEN is a startup failure rather
# than a silently open API.
# ADMIN_TOKEN_REQUIRED=true

# Set to false on a public host: unregisters the unsigned /api/chat routes.
# ENABLE_DEMO_CHAT=true

# Per-shop cap on storefront chat turns, sliding 60s window.
# PROXY_CHAT_RATE_PER_MIN=20
